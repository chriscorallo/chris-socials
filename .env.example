# Copy to .env.local (or .env for scripts) and fill in real values.
# NEVER commit a file containing real secrets. See /docs/SECURITY.md.

# --- Database ---
# Local dev/test (this sandbox): served by `pnpm db:up` (PGlite over the Postgres wire
# protocol — see /docs/DECISIONS.md). Production: a real managed Postgres (Neon via Vercel
# Marketplace) — only the connection string changes.
DATABASE_URL="postgresql://chris:chris@localhost:55432/chris_dev?connection_limit=1"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# --- Seed (dev only — see /docs/DECISIONS.md, rotate before any production deploy) ---
SEED_USER_EMAIL="chris@example.com"
SEED_USER_PASSWORD="replace-with-a-dev-only-password"

# --- Legacy platform tokens (fallback only) ---
# Prefer connecting accounts at /settings/connections (encrypted, auto-refreshed). These env
# tokens are only used when no connection is stored for that platform.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_IG_USER_ID=""
YOUTUBE_ACCESS_TOKEN=""
TIKTOK_ACCESS_TOKEN=""
# "true" only once this app has TikTok Content Posting API audit approval — see
# /docs/DECISIONS.md. Defaults to unaudited (private/draft fallback) when unset.
TIKTOK_APP_AUDITED="false"
# Encrypts PlatformCredential rows at rest (packages/platforms/src/token-crypto.ts). Generate
# with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-a-real-random-secret"

# --- Model providers (not introduced until Phase 2 — placeholders only) ---
ANTHROPIC_API_KEY=""

# Optional. Rolling-UTC-day USD ceiling on real model spend — see
# packages/agents/src/spend-cap.ts. A call that would push today's spend at/over this cap is
# refused before it ever reaches Anthropic (no tokens spent) and is written to AuditLog as
# MODEL_SPEND_CAP_BLOCKED. Unset uses the coded default (packages/agents/src/spend-cap.ts's
# DEFAULT_DAILY_SPEND_CAP_USD, currently $30/day). Set to "0" to block all real spend outright.
# MODEL_SPEND_DAILY_CAP_USD="30"

# --- App ---
# Chris's local time zone — schedule inputs, calendar days, and displays use it (Vercel runs in
# UTC and reserves the TZ var itself). See apps/web/instrumentation.ts.
APP_TIMEZONE="America/Los_Angeles"
# Public base URL of the deployment — OAuth redirect URIs and the GitHub cron tick use it.
APP_BASE_URL="http://localhost:3000"
# Only needed when self-hosting with `next start` (Vercel trusts the host automatically).
# AUTH_TRUST_HOST="true"

# --- Storage ---
# Unset locally: files go to <repo>/.storage (STORAGE_LOCAL_DIR overrides).
# Production: connect a PRIVATE Vercel Blob store to the project — Vercel sets this for you.
# BLOB_READ_WRITE_TOKEN=""
# STORAGE_LOCAL_DIR=""

# --- Rendering / transcription ---
# Optional: override the bundled Inter fonts with your own TTF (must exist).
# RENDER_FONT_PATH=""
# Local Whisper transcription: on by default locally, off on Vercel. on|off overrides.
# TRANSCRIPTION="on"
# TRANSCRIPTION_MODEL="onnx-community/whisper-base.en_timestamped"
# TRANSCRIPTION_CACHE_DIR=""

# --- Background jobs (scheduled publishing, metric snapshots) ---
# Any long random string; Vercel Cron and the GitHub Actions tick send it as a Bearer token.
CRON_SECRET="replace-with-a-real-random-secret"

# --- Platform OAuth apps (connect accounts at /settings/connections) ---
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# INSTAGRAM_GRAPH_API_VERSION="v25.0"
# public | unlisted | private
# YOUTUBE_PRIVACY_STATUS="public"
# INBOX (lands in your TikTok inbox to finish in the app) | DIRECT (needs TikTok audit)
# TIKTOK_POST_MODE="INBOX"

# --- Research ---
# Live web search/fetch for Research + Claims Gate (primary sources, real citation URLs).
# RESEARCH_WEB_SEARCH="on"
# RESEARCH_WEB_SEARCH_MAX_USES="5"
# CLAIMS_GATE_WEB_SEARCH_MAX_USES="3"
# RESEARCH_WEB_FETCH_MAX_USES="3"
# MODEL_REFUSAL_FALLBACK="on"
# Optional model overrides (defaults: claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5)
# MODEL_HIGH=""
# MODEL_MEDIUM=""
# MODEL_LOW=""
